#!/usr/bin/env python3
"""Monitor Linux RAM use and alert through GNOME Shell and an MP3 player."""
from __future__ import annotations

import argparse
import math
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

VERSION = "1.0.0"
DEFAULT_THRESHOLD = "14.5GiB"
EXTENSION_UUID = "ram-alert@local"
DBUS_NAME = "org.gnome.Shell.Extensions.RamAlert"
DBUS_PATH = "/org/gnome/Shell/Extensions/RamAlert"
DBUS_INTERFACE = "org.gnome.Shell.Extensions.RamAlert"
FLASH_MS = 10000
POLL_SECONDS = 2.0
REARM_HYSTERESIS = 0.5 * (1024 ** 3)
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "ram-alert"
AUDIO_CONFIG = CONFIG_DIR / "audio-path"


def parse_bytes(raw: str) -> int:
    """Parse a memory threshold. Unitless values mean GiB."""
    value = raw.strip().replace(" ", "")
    match = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)([A-Za-z]*)", value)
    if not match:
        raise argparse.ArgumentTypeError(
            f"invalid threshold {raw!r}; use values such as 14.5, 14.5GiB, or 14500MB"
        )
    amount = float(match.group(1))
    unit = match.group(2).upper()
    if amount < 0 or not math.isfinite(amount):
        raise argparse.ArgumentTypeError("threshold must be a non-negative number")
    factors = {
        "": 1024 ** 3, "G": 1024 ** 3, "GIB": 1024 ** 3,
        "GB": 1000 ** 3, "M": 1024 ** 2, "MIB": 1024 ** 2,
        "MB": 1000 ** 2, "K": 1024, "KIB": 1024, "KB": 1000,
        "T": 1024 ** 4, "TIB": 1024 ** 4, "TB": 1000 ** 4,
        "B": 1,
    }
    if unit not in factors:
        raise argparse.ArgumentTypeError(
            f"unknown unit {unit!r}; use B, KB, KiB, MB, MiB, GB, GiB, TB, or TiB"
        )
    return int(amount * factors[unit])


def read_memory() -> tuple[int, int]:
    """Return (used bytes, total bytes), using MemTotal - MemAvailable."""
    meminfo = {}
    try:
        with open("/proc/meminfo", "r", encoding="ascii") as stream:
            for line in stream:
                key, _, rest = line.partition(":")
                if key in ("MemTotal", "MemAvailable"):
                    fields = rest.split()
                    meminfo[key] = int(fields[0]) * 1024
    except (OSError, ValueError, IndexError) as exc:
        raise RuntimeError(f"cannot read /proc/meminfo: {exc}") from exc
    if "MemTotal" not in meminfo or "MemAvailable" not in meminfo:
        raise RuntimeError("/proc/meminfo did not contain MemTotal and MemAvailable")
    total = meminfo["MemTotal"]
    available = min(meminfo["MemAvailable"], total)
    return max(0, total - available), total


def gib(value: int) -> str:
    return f"{value / (1024 ** 3):.2f} GiB"


def get_audio_path() -> Path | None:
    try:
        raw = AUDIO_CONFIG.read_text(encoding="utf-8").strip()
    except OSError:
        return None
    if not raw:
        return None
    return Path(raw).expanduser()


def set_audio_path(path_string: str) -> int:
    path = Path(path_string).expanduser()
    try:
        path = path.resolve(strict=True)
    except OSError:
        print(f"Error: audio file does not exist: {path}", file=sys.stderr)
        return 2
    if not path.is_file() or not os.access(path, os.R_OK):
        print(f"Error: audio path is not a readable file: {path}", file=sys.stderr)
        return 2
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    AUDIO_CONFIG.write_text(str(path) + "\n", encoding="utf-8")
    print(f"Alert audio set to: {path}")
    return 0


def find_audio_player() -> tuple[str, list[str]] | None:
    players = [
        ("mpv", ["--no-video", "--no-terminal", "--really-quiet"]),
        ("ffplay", ["-nodisp", "-autoexit", "-loglevel", "error"]),
        ("gst-play-1.0", ["--quiet"]),
        ("mpg123", ["-q"]),
        ("cvlc", ["--intf", "dummy", "--play-and-exit", "--quiet"]),
        ("vlc", ["--intf", "dummy", "--play-and-exit", "--quiet"]),
        ("mplayer", ["-really-quiet", "-nolirc", "-noconsolecontrols"]),
    ]
    for name, args in players:
        resolved = shutil.which(name)
        if resolved:
            return resolved, args
    return None


def play_audio(audio_path: Path | None) -> bool:
    if audio_path is None:
        print(
            f"ERROR: no audio file configured. Set it with: ram-alert --set-audio /path/to/alert.mp3",
            file=sys.stderr,
        )
        return False
    if not audio_path.is_file() or not os.access(audio_path, os.R_OK):
        print(f"ERROR: alert audio file is missing or unreadable: {audio_path}", file=sys.stderr)
        return False
    player = find_audio_player()
    if player is None:
        print("ERROR: no supported MP3 player found. Install one with: sudo dnf install mpv", file=sys.stderr)
        return False
    executable, flags = player
    try:
        subprocess.Popen(
            [executable, *flags, str(audio_path)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return True
    except OSError as exc:
        print(f"ERROR: could not start audio player: {exc}", file=sys.stderr)
        return False


def flash_top_bar() -> bool:
    gdbus = shutil.which("gdbus")
    if not gdbus:
        print("ERROR: gdbus was not found; cannot request a GNOME top-bar flash.", file=sys.stderr)
        return False
    command = [
        gdbus, "call", "--session", "--dest", DBUS_NAME,
        "--object-path", DBUS_PATH, "--method", f"{DBUS_INTERFACE}.Flash", str(FLASH_MS),
    ]
    last_error = "D-Bus call failed"
    for attempt in range(4):
        try:
            result = subprocess.run(command, text=True, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.PIPE, timeout=2, check=False)
        except (OSError, subprocess.TimeoutExpired) as exc:
            last_error = str(exc)
        else:
            if result.returncode == 0:
                return True
            last_error = result.stderr.strip() or "D-Bus call failed"
        if attempt < 3:
            time.sleep(0.25)
    print(
        "ERROR: GNOME top-bar flash extension is not responding. "
        f"Check that {EXTENSION_UUID} is enabled. Details: {last_error}",
        file=sys.stderr,
    )
    return False


def alert(used: int, total: int, threshold: int) -> int:
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    print(
        f"[{stamp}] RAM threshold reached: {gib(used)} used / {gib(total)} total "
        f"(threshold {gib(threshold)}).",
        flush=True,
    )
    # Start the sound first so the alert is immediate even if the extension
    # takes a moment to answer on D-Bus.
    audio_ok = play_audio(get_audio_path())
    bar_ok = flash_top_bar()
    return 0 if bar_ok and audio_ok else 1


def print_status(threshold: int) -> int:
    try:
        used, total = read_memory()
        print(f"RAM now:       {gib(used)} used / {gib(total)} total")
    except RuntimeError as exc:
        print(f"RAM status:    unavailable ({exc})")
    print(f"Threshold:     {gib(threshold)}")
    audio = get_audio_path()
    print(f"Alert audio:   {audio if audio else 'NOT CONFIGURED'}")
    if audio and (not audio.is_file() or not os.access(audio, os.R_OK)):
        print("Audio status:   MISSING OR NOT READABLE")
    else:
        print("Audio status:   OK" if audio else "Audio status:   NOT CONFIGURED")
    result = subprocess.run(["systemctl", "--user", "is-active", "ram-alert.service"],
                            text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                            check=False) if shutil.which("systemctl") else None
    print(f"User service:   {result.stdout.strip() if result and result.returncode == 0 else 'not active'}")
    ext = subprocess.run(["gnome-extensions", "info", EXTENSION_UUID],
                         text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                         check=False) if shutil.which("gnome-extensions") else None
    if ext and ext.returncode == 0:
        state = next((line.strip() for line in ext.stdout.splitlines()
                      if "State:" in line), "installed")
        print(f"GNOME extension: {state}")
    else:
        print("GNOME extension: not found or not available")
    return 0


def wait_for_threshold(threshold: int, one_shot: bool) -> int:
    mode = "one-shot test" if one_shot else "monitor"
    print(f"ram-alert {VERSION}: {mode}; threshold {gib(threshold)}; polling every {POLL_SECONDS:g}s.",
          flush=True)
    if not one_shot:
        print(f"Re-arms after memory use falls below {gib(max(0, threshold - REARM_HYSTERESIS))}.",
              flush=True)
    armed = True
    while True:
        try:
            used, total = read_memory()
        except RuntimeError as exc:
            print(f"ERROR: {exc}", file=sys.stderr, flush=True)
            time.sleep(POLL_SECONDS)
            continue
        if one_shot:
            if used >= threshold:
                return alert(used, total, threshold)
        else:
            if armed and used >= threshold:
                alert(used, total, threshold)
                armed = False
            elif not armed and used < max(0, threshold - REARM_HYSTERESIS):
                armed = True
        time.sleep(POLL_SECONDS)


def make_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="ram-alert",
        description=(
            "Monitor RAM use and play alert.mp3 while flashing the GNOME top bar. "
            "The usage estimate is MemTotal minus MemAvailable."
        ),
        epilog=(
            "Examples:\n"
            "  ram-alert                         Monitor continuously at 14.5 GiB\n"
            "  ram-alert --threshold 14.5        Monitor continuously at 14.5 GiB\n"
            "  ram-alert --test 14.5             Wait for 14.5 GiB, alert once, then exit\n"
            "  ram-alert --test 0                Trigger an immediate alert test\n"
            "  ram-alert --set-audio ~/Music/alert.mp3\n"
            "  ram-alert --status"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--test", metavar="THRESHOLD",
                      help="one-shot monitor; alert and exit when this threshold is reached")
    mode.add_argument("--status", action="store_true", help="show RAM, audio, extension, and service status")
    mode.add_argument("--set-audio", metavar="PATH", help="save the alert audio file path")
    parser.add_argument("--threshold", default=DEFAULT_THRESHOLD, metavar="THRESHOLD",
                        help=f"continuous-monitor threshold (default: {DEFAULT_THRESHOLD})")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    return parser


def main() -> int:
    parser = make_parser()
    args = parser.parse_args()
    if args.set_audio:
        return set_audio_path(args.set_audio)
    try:
        threshold = parse_bytes(args.test if args.test is not None else args.threshold)
    except argparse.ArgumentTypeError as exc:
        parser.error(str(exc))
    if args.status:
        return print_status(threshold)
    try:
        return wait_for_threshold(threshold, one_shot=args.test is not None)
    except KeyboardInterrupt:
        print("\nram-alert stopped.", flush=True)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
